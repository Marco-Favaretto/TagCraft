<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/sql">
        <file alias="schema.sql">src/sql/schema.sql</file>
        <file alias="startvalues.sql">src/sql/startvalues.sql</file>
        <file alias="resetdb.sql">src/sql/resetdb.sql</file>
        <file alias="track.sql">src/sql/track.sql</file>
        <file alias="artist.sql">src/sql/artist.sql</file>
        <file alias="album.sql">src/sql/album.sql</file>
        <file alias="genre.sql">src/sql/genre.sql</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="track">src/icons/track-icon.jpg</file>
        <file alias="album">src/icons/album-icon.jpg</file>
        <file alias="artist">src/icons/artist-icon.jpg</file>
        <file alias="genre">src/icons/genre-icon.jpg</file>
        <file alias="trash">src/icons/iamtrash.jpg</file>
        <file alias="folder">src/icons/folder-icon.jpg</file>
        <file alias="edit">src/icons/edit-icon.jpg</file>
    </qresource>
</RCC>