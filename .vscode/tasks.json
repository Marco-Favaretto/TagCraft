{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run TagCraft",
            "type": "shell",
            "command": "rm -rf build && cmake -S . -B build && cmake --build build && ./build/TagCraft",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}